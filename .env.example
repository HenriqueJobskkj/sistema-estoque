# Modelo de configuração do sistema.
# Copie este arquivo para ".env" e ajuste os valores para o seu computador.
# O arquivo ".env" NÃO vai para o GitHub (está no .gitignore).

# Nome do servidor SQL Server (o mesmo que você usa para conectar no SSMS)
# Exemplos: localhost | .\SQLEXPRESS | (localdb)\MSSQLLocalDB
DB_SERVIDOR=localhost

# Nome do banco de dados
DB_BANCO=SistemaEstoque

# Driver ODBC (veja os instalados com: python -c "import pyodbc; print(pyodbc.drivers())")
DB_DRIVER=ODBC Driver 17 for SQL Server

# Chave secreta do Flask: troque por um texto longo e aleatório
SECRET_KEY=troque-esta-chave-por-um-texto-longo-e-aleatorio

# Modo debug do Flask: 1 = ligado (desenvolvimento), 0 = desligado
FLASK_DEBUG=1